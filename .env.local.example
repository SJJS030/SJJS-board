# Supabase 레거시 API 키 방식: Settings > API Keys의 Legacy API Keys에서 복사합니다.
# 프로젝트 URL과 공개 anon 키 (eyJ로 시작하는 JWT, 브라우저에 공개됩니다.)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용: 브라우저에 공개하거나 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# 레거시 service_role 키 (eyJ로 시작하는 JWT)
SUPABASE_SERVICE_ROLE_KEY=
# npm run setup으로 생성 권장. .env.local의 bcrypt 해시는 $를 \$로 적으세요.
# Vercel 환경 변수 화면에는 역슬래시 없이 원래 $를 입력하세요.
ADMIN_PASSWORD_HASH=
# 32자 이상의 무작위 값 (npm run setup은 64자리 hex를 생성합니다.)
ADMIN_SESSION_SECRET=
